#!/bin/bash
set -euo pipefail
export PATH=/usr/sbin:/usr/bin
export LC_ALL=C
umask 077

[[ $EUID == 0 && $# == 2 ]] || exit 2
mode=$1
user=$2
[[ $mode == status || $mode == apply || $mode == force || $mode == discover ]] || exit 2
[[ $user =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || exit 2

if [[ $mode == discover ]]; then
    [[ -r /etc/shells && -r /etc/login.defs ]] || exit 2
    getent -s files passwd | awk -F: '
        BEGIN { min = 1000; max = 60000 }
        FILENAME == ARGV[1] {
            split($0, fields, /[[:blank:]]+/)
            if (fields[2] ~ /^[0-9]+$/) {
                if (fields[1] == "UID_MIN") min = fields[2] + 0
                if (fields[1] == "UID_MAX") max = fields[2] + 0
            }
            next
        }
        FILENAME == ARGV[2] {
            if ($0 ~ /^\// && $0 !~ /\/(nologin|false)$/) shells[$0] = 1
            next
        }
        $1 ~ /^[a-z_][a-z0-9_-]*$/ && length($1) <= 32 && $1 != "root" &&
            $3 ~ /^[0-9]+$/ && $3 > 0 && $3 >= min && $3 <= max && $7 in shells { print $1 }
    ' /etc/login.defs /etc/shells -
    exit 0
fi

exec 9>/run/jms-password-rotate.lock
flock -w 10 9

account=$(getent -s files passwd "$user")
IFS=: read -r account_name _ uid _ <<< "$account"
[[ $account_name == "$user" && $uid =~ ^[0-9]+$ && $uid != 0 ]] || exit 2

shadow=$(getent -s files shadow "$user")
IFS=: read -r shadow_name hash last minimum maximum _ inactive expiry _ <<< "$shadow"
[[ $shadow_name == "$user" ]] || exit 2
today=$(( $(date -u +%s) / 86400 ))
for value in "$last" "$minimum" "$maximum" "$inactive" "$expiry"; do
    [[ -z $value || $value == -1 || $value =~ ^(0|[1-9][0-9]{0,8})$ ]] || exit 2
done

if [[ $hash != \$* ]] || { [[ -n $expiry && $expiry != -1 ]] && (( today >= expiry )); }; then
    echo INELIGIBLE
    exit 0
fi
if [[ $last != 0 ]]; then
    if [[ -z $last || $last == -1 || -z $maximum || $maximum == -1 ]]; then
        echo NO_EXPIRY
        exit 0
    fi
    if [[ $mode != force ]] && (( today < last + maximum - 1 )); then
        echo NOT_DUE
        exit 0
    fi
    if [[ -n $minimum && $minimum != -1 ]] && (( maximum < minimum || today < last + minimum )); then
        echo INELIGIBLE
        exit 0
    fi
    if [[ -n $inactive && $inactive != -1 ]] && (( today > last + maximum + inactive )); then
        echo INELIGIBLE
        exit 0
    fi
fi

if [[ $mode == status ]]; then
    echo DUE
    exit 0
fi

IFS= read -r password
[[ $password =~ ^[A-Za-z0-9_@%+=.-]{32}$ ]] || exit 2
printf '%s:%s\n' "$user" "$password" | chpasswd >/dev/null 2>&1
echo CHANGED
